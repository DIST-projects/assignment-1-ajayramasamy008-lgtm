#include <stdio.h>

int main() {
    int a[100], n, i, j, temp;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    for (i = 1; i < n; i++) {
        j = i;

        while (j > 0 && a[(j - 1) / 2] < a[j]) {
            temp = a[j];
            a[j] = a[(j - 1) / 2];
            a[(j - 1) / 2] = temp;
            j = (j - 1) / 2;
        }
    }

    printf("Max Heap: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
