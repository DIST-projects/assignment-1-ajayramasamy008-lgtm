#include <stdio.h>

int a[10][10], color[10], n;

int bfs(int s) {
    int q[100], front = 0, rear = 0;

    q[rear++] = s;
    color[s] = 0;

    while (front < rear) {
        int u = q[front++];

        for (int v = 0; v < n; v++) {
            if (a[u][v]) {
                if (color[v] == -1) {
                    color[v] = 1 - color[u];
                    q[rear++] = v;
                }
                else if (color[v] == color[u])
                    return 0;
            }
        }
    }

    return 1;
}

int main() {
    int e, u, v;

    printf("Enter vertices and edges: ");
    scanf("%d%d", &n, &e);

    for (int i = 0; i < e; i++) {
        scanf("%d%d", &u, &v);
        a[u][v] = a[v][u] = 1;
    }

    for (int i = 0; i < n; i++)
        color[i] = -1;

    for (int i = 0; i < n; i++) {
        if (color[i] == -1 && !bfs(i)) {
            printf("Not Bipartite");
            return 0;
        }
    }

    printf("Bipartite Graph");
    return 0;
}
