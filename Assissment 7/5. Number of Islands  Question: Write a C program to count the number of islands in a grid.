#include <stdio.h>

char a[10][10];
int m, n;

void dfs(int i, int j) {
    if (i < 0 || j < 0 || i >= m || j >= n ||
        a[i][j] == '0')
        return;

    a[i][j] = '0';

    dfs(i + 1, j);
    dfs(i - 1, j);
    dfs(i, j + 1);
    dfs(i, j - 1);
}

int main() {
    int count = 0;

    printf("Enter rows and columns: ");
    scanf("%d%d", &m, &n);

    printf("Enter grid: ");
    for (int i = 0; i < m; i++)
        for (int j = 0; j < n; j++)
            scanf(" %c", &a[i][j]);

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            if (a[i][j] == '1') {
                count++;
                dfs(i, j);
            }
        }
    }

    printf("Number of islands: %d", count);
    return 0;
}
