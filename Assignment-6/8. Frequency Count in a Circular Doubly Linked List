
#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *prev, *next;
};

struct Node *head = NULL;

void insert(int x) {
    struct Node *n = malloc(sizeof(struct Node));
    n->data = x;

    if (!head) {
        head = n;
        n->next = n->prev = n;
    } else {
        struct Node *last = head->prev;
        n->next = head;
        n->prev = last;
        last->next = n;
        head->prev = n;
    }
}

int main() {
    insert(10);
    insert(20);
    insert(10);
    insert(30);
    insert(10);

    int key, count = 0;
    struct Node *t = head;

    printf("Enter element: ");
    scanf("%d", &key);

    if (head) {
        do {
            if (t->data == key)
                count++;
            t = t->next;
        } while (t != head);
    }

    printf("Frequency = %d", count);
    return 0;
}
