
#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *prev, *next;
};

struct Node *head = NULL;

void insert(int x) {
    struct Node *n = malloc(sizeof(struct Node));
    n->data = x;
    n->prev = n->next = NULL;

    if (!head) {
        head = n;
        return;
    }

    struct Node *t = head;
    while (t->next)
        t = t->next;

    t->next = n;
    n->prev = t;
}

void deleteMiddle() {
    if (!head) return;

    struct Node *slow = head, *fast = head;

    while (fast->next && fast->next->next) {
        slow = slow->next;
        fast = fast->next->next;
    }

    if (slow->prev)
        slow->prev->next = slow->next;
    else
        head = slow->next;

    if (slow->next)
        slow->next->prev = slow->prev;

    free(slow);
}

void display() {
    struct Node *t = head;
    while (t) {
        printf("%d ", t->data);
        t = t->next;
    }
}

int main() {
    insert(10);
    insert(20);
    insert(30);
    insert(40);
    insert(50);

    deleteMiddle();
    display();
    return 0;
}
