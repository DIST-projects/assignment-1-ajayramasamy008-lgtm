
#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *prev, *next;
};

struct Node *head = NULL;

void insert(int x) {
    struct Node *n = malloc(sizeof(struct Node));
    n->data = x;
    n->prev = n->next = NULL;

    if (!head) {
        head = n;
        return;
    }

    struct Node *t = head;
    while (t->next) t = t->next;
    t->next = n;
    n->prev = t;
}

void removeDuplicates() {
    struct Node *p = head;

    while (p) {
        struct Node *q = p->next;

        while (q) {
            if (q->data == p->data) {
                struct Node *d = q;
                q = q->next;

                if (d->prev) d->prev->next = d->next;
                if (d->next) d->next->prev = d->prev;

                free(d);
            } else {
                q = q->next;
            }
        }
        p = p->next;
    }
}

void display() {
    struct Node *t = head;
    while (t) {
        printf("%d ", t->data);
        t = t->next;
    }
}

int main() {
    insert(10);
    insert(20);
    insert(10);
    insert(30);
    insert(20);

    removeDuplicates();
    display();
    return 0;
}
