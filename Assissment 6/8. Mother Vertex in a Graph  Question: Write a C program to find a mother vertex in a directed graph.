#include <stdio.h>

int a[10][10], visited[10], n;

void dfs(int v) {
    visited[v] = 1;

    for (int i = 0; i < n; i++)
        if (a[v][i] && !visited[i])
            dfs(i);
}

int main() {
    int e, u, v, candidate = 0;

    printf("Enter vertices and edges: ");
    scanf("%d%d", &n, &e);

    for (int i = 0; i < e; i++) {
        scanf("%d%d", &u, &v);
        a[u][v] = 1;
    }

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            dfs(i);
            candidate = i;
        }
    }

    for (int i = 0; i < n; i++)
        visited[i] = 0;

    dfs(candidate);

    for (int i = 0; i < n; i++)
        if (!visited[i]) {
            printf("No mother vertex");
            return 0;
        }

    printf("Mother vertex: %d", candidate);
    return 0;
}
