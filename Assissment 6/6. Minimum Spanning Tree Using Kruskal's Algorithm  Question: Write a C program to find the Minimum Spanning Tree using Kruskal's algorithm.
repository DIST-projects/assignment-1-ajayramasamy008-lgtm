#include <stdio.h>

struct Edge {
    int u, v, w;
};

int parent[20];

int find(int x) {
    while (parent[x] != x)
        x = parent[x];
    return x;
}

int main() {
    struct Edge e[100], temp;
    int n, m, cost = 0, count = 0;

    printf("Enter vertices and edges: ");
    scanf("%d%d", &n, &m);

    for (int i = 0; i < m; i++)
        scanf("%d%d%d", &e[i].u, &e[i].v, &e[i].w);

    for (int i = 0; i < n; i++)
        parent[i] = i;

    for (int i = 0; i < m - 1; i++)
        for (int j = i + 1; j < m; j++)
            if (e[i].w > e[j].w) {
                temp = e[i];
                e[i] = e[j];
                e[j] = temp;
            }

    for (int i = 0; i < m && count < n - 1; i++) {
        int a = find(e[i].u);
        int b = find(e[i].v);

        if (a != b) {
            parent[a] = b;
            cost += e[i].w;
            count++;

            printf("%d - %d : %d\n",
                   e[i].u, e[i].v, e[i].w);
        }
    }

    if (count == n - 1)
        printf("Minimum cost = %d", cost);
    else
        printf("Spanning tree does not exist");

    return 0;
}
