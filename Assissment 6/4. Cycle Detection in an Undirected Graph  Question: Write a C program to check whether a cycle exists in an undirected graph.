#include <stdio.h>

int graph[10][10], visited[10], n;

int dfs(int v, int parent) {
    visited[v] = 1;

    for (int i = 0; i < n; i++) {
        if (graph[v][i]) {
            if (!visited[i]) {
                if (dfs(i, v))
                    return 1;
            }
            else if (i != parent)
                return 1;
        }
    }

    return 0;
}

int main() {
    int e, u, v;

    printf("Enter vertices and edges: ");
    scanf("%d%d", &n, &e);

    for (int i = 0; i < e; i++) {
        scanf("%d%d", &u, &v);
        graph[u][v] = graph[v][u] = 1;
    }

    if (dfs(0, -1))
        printf("Cycle exists");
    else
        printf("Cycle does not exist");

    return 0;
}
