#include <stdio.h>

#define INF 9999

int main() {
    int a[10][10], d[10], visited[10] = {0};
    int n, src, u, min;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix (0 for no edge):\n");
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
            if (i != j && a[i][j] == 0)
                a[i][j] = INF;
        }

    printf("Enter source: ");
    scanf("%d", &src);

    for (int i = 0; i < n; i++)
        d[i] = INF;

    d[src] = 0;

    for (int k = 0; k < n; k++) {
        min = INF;
        u = -1;

        for (int i = 0; i < n; i++)
            if (!visited[i] && d[i] < min) {
                min = d[i];
                u = i;
            }

        if (u == -1)
            break;

        visited[u] = 1;

        for (int v = 0; v < n; v++)
            if (!visited[v] && a[u][v] != INF &&
                d[u] + a[u][v] < d[v])
                d[v] = d[u] + a[u][v];
    }

    printf("Shortest distances:\n");
    for (int i = 0; i < n; i++)
        printf("%d -> %d = %d\n", src, i, d[i]);

    return 0;
}
