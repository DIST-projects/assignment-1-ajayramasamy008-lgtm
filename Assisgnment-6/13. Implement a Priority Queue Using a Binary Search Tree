
#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *left, *right;
};

struct Node *insert(struct Node *r, int x) {
    if (!r) {
        r = malloc(sizeof(struct Node));
        r->data = x;
        r->left = r->right = NULL;
    } else if (x < r->data)
        r->left = insert(r->left, x);
    else if (x > r->data)
        r->right = insert(r->right, x);

    return r;
}

int search(struct Node *r, int x) {
    if (!r) return 0;
    if (r->data == x) return 1;

    if (x < r->data)
        return search(r->left, x);

    return search(r->right, x);
}

struct Node *deleteNode(struct Node *r, int x) {
    if (!r) return NULL;

    if (x < r->data)
        r->left = deleteNode(r->left, x);
    else if (x > r->data)
        r->right = deleteNode(r->right, x);
    else {
        if (!r->left) return r->right;
        if (!r->right) return r->left;

        struct Node *t = r->right;
        while (t->left) t = t->left;

        r->data = t->data;
        r->right = deleteNode(r->right, t->data);
    }
    return r;
}

int highestPriority(struct Node *r) {
    while (r->right)
        r = r->right;
    return r->data;
}

int main() {
    struct Node *root = NULL;

    root = insert(root, 30);
    root = insert(root, 10);
    root = insert(root, 50);
    root = insert(root, 20);

    printf("Highest priority = %d\n",
           highestPriority(root));

    printf("Search 20: %s\n",
           search(root, 20) ? "Found" : "Not Found");

    root = deleteNode(root, 50);
    printf("Deleted 50\n");

    return 0;
}
