#include<stdio.h>
#include<stdlib.h>

struct Node{
    int c,p;
    struct Node *next;
};

struct Node* create(int n){
    struct Node *h=NULL,*t=NULL,*x;
    int i;
    for(i=0;i<n;i++){
        x=malloc(sizeof(*x));
        scanf("%d%d",&x->c,&x->p);
        x->next=NULL;
        if(!h) h=t=x;
        else t=t->next=x;
    }
    return h;
}

struct Node* calc(struct Node *a,struct Node *b,int s){
    struct Node *h=NULL,*t=NULL,*x;
    while(a||b){
        x=malloc(sizeof(*x));
        if(!b||(a&&a->p>b->p)){
            x->c=a->c;x->p=a->p;a=a->next;
        }else if(!a||b->p>a->p){
            x->c=s*b->c;x->p=b->p;b=b->next;
        }else{
            x->c=a->c+s*b->c;x->p=a->p;
            a=a->next;b=b->next;
        }
        x->next=NULL;
        if(!h)h=t=x;
        else t=t->next=x;
    }
    return h;
}

void display(struct Node *p){
    while(p){
        printf("%dx^%d ",p->c,p->p);
        p=p->next;
    }
}

int main(){
    struct Node *a,*b,*r;
    int n,m;

    scanf("%d",&n);
    a=create(n);
    scanf("%d",&m);
    b=create(m);

    r=calc(a,b,1);
    display(r);
    printf("\n");

    r=calc(a,b,-1);
    display(r);
}
