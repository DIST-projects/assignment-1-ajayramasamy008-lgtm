#include <stdio.h>

struct Edge {
    int u, v, w;
} e[100], t;

int p[50];

int find(int x) {
    while (p[x] != x)
        x = p[x];
    return x;
}

int main() {
    int n, m, i, j, cost = 0, count = 0;

    scanf("%d%d", &n, &m);

    for (i = 0; i < m; i++)
        scanf("%d%d%d", &e[i].u, &e[i].v, &e[i].w);

    for (i = 0; i < n; i++)
        p[i] = i;

    for (i = 0; i < m - 1; i++)
        for (j = 0; j < m - i - 1; j++)
            if (e[j].w > e[j + 1].w) {
                t = e[j];
                e[j] = e[j + 1];
                e[j + 1] = t;
            }

    for (i = 0; i < m && count < n - 1; i++) {
        int a = find(e[i].u);
        int b = find(e[i].v);

        if (a != b) {
            printf("%d %d %d\n",
                   e[i].u, e[i].v, e[i].w);
            p[a] = b;
            cost += e[i].w;
            count++;
        }
    }

    if (count == n - 1)
        printf("MST cost = %d", cost);
    else
        printf("No spanning tree exists");

    return 0;
}
