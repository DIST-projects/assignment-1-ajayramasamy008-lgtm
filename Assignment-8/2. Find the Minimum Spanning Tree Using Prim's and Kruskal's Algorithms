A. Prim's Algorithm
#include <stdio.h>

#define INF 99999

int main() {
    int a[10][10], selected[10] = {0};
    int n, i, j, edges = 0, min, x = 0, y = 0, cost = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost matrix (0 for no edge):\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
            if (i != j && a[i][j] == 0)
                a[i][j] = INF;
        }

    selected[0] = 1;

    while (edges < n - 1) {
        min = INF;

        for (i = 0; i < n; i++)
            if (selected[i])
                for (j = 0; j < n; j++)
                    if (!selected[j] && a[i][j] < min) {
                        min = a[i][j];
                        x = i;
                        y = j;
                    }

        if (min == INF) {
            printf("Graph is disconnected");
            return 0;
        }

        printf("%d - %d : %d\n", x, y, min);
        cost += min;
        selected[y] = 1;
        edges++;
    }

    printf("Minimum cost = %d", cost);
    return 0;
}
B. Kruskal's Algorithm
#include <stdio.h>

struct Edge {
    int u, v, w;
} e[50], t;

int parent[20];

int find(int x) {
    while (parent[x] != x)
        x = parent[x];
    return x;
}

int main() {
    int n, m, i, j, cost = 0, count = 0;

    printf("Enter vertices and edges: ");
    scanf("%d%d", &n, &m);

    printf("Enter edges (u v weight):\n");
    for (i = 0; i < m; i++)
        scanf("%d%d%d", &e[i].u, &e[i].v, &e[i].w);

    for (i = 0; i < n; i++)
        parent[i] = i;

    for (i = 0; i < m - 1; i++)
        for (j = 0; j < m - i - 1; j++)
            if (e[j].w > e[j + 1].w) {
                t = e[j];
                e[j] = e[j + 1];
                e[j + 1] = t;
            }

    for (i = 0; i < m && count < n - 1; i++) {
        int a = find(e[i].u);
        int b = find(e[i].v);

        if (a != b) {
            printf("%d - %d : %d\n",
                   e[i].u, e[i].v, e[i].w);

            parent[a] = b;
            cost += e[i].w;
            count++;
        }
    }

    if (count != n - 1)
        printf("Graph is disconnected");
    else
        printf("Minimum cost = %d", cost);

    return 0;
}
