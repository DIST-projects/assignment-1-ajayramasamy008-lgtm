#include <stdio.h>

int main() {
    int h[7], a[] = {76, 93, 40, 47, 10, 55};
    int i, j, k;

    for (i = 0; i < 7; i++)
        h[i] = -1;

    for (i = 0; i < 6; i++) {
        k = a[i] % 7;

        while (h[k] != -1)
            k = (k + 1) % 7;

        h[k] = a[i];
    }

    printf("Index\tValue\n");
    for (i = 0; i < 7; i++)
        printf("%d\t%d\n", i, h[i]);

    return 0;
}
