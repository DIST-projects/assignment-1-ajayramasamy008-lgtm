#include <stdio.h>

int main() {
    int h[7], a[] = {22, 30, 50};
    int i, j, k;

    for (i = 0; i < 7; i++)
        h[i] = -1;

    for (i = 0; i < 3; i++) {
        k = a[i] % 7;

        for (j = 0; j < 7; j++) {
            int pos = (k + j * j) % 7;

            if (h[pos] == -1) {
                h[pos] = a[i];
                break;
            }
        }
    }

    for (i = 0; i < 7; i++)
        printf("%d: %d\n", i, h[i]);

    return 0;
}
