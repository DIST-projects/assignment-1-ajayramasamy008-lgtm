#include <stdio.h>

int main() {
    int h[7], a[] = {27, 43, 69, 72};
    int i, j, k, pos;

    for (i = 0; i < 7; i++)
        h[i] = -1;

    for (i = 0; i < 4; i++) {
        k = a[i];

        for (j = 0; j < 7; j++) {
            pos = (k % 7 + j * (1 + k % 5)) % 7;

            if (h[pos] == -1) {
                h[pos] = k;
                break;
            }
        }
    }

    for (i = 0; i < 7; i++)
        printf("%d: %d\n", i, h[i]);

    return 0;
}
