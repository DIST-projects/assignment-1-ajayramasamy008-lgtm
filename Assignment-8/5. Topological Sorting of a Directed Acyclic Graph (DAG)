#include <stdio.h>

int main() {
    int a[10][10], indeg[10] = {0};
    int q[10], order[10];
    int n, i, j, front = 0, rear = 0, k = 0, u;

    scanf("%d", &n);

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
            if (a[i][j])
                indeg[j]++;
        }

    for (i = 0; i < n; i++)
        if (indeg[i] == 0)
            q[rear++] = i;

    while (front < rear) {
        u = q[front++];
        order[k++] = u;

        for (j = 0; j < n; j++)
            if (a[u][j] && --indeg[j] == 0)
                q[rear++] = j;
    }

    if (k != n)
        printf("Graph contains a cycle");
    else {
        printf("Topological order: ");
        for (i = 0; i < n; i++)
            printf("%d ", order[i]);
    }

    return 0;
}
